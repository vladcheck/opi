/*
    OPI LANGUAGE CONSTRUCT EXAMPLES

    /* Nested multiline comment */
*/


// Operators
, . :       // punctuation
!= !        // exclamation
+= ++ +     // plus
-= -- -     // minus
*= *        // star
/= /        // slash
%= %        // percent
== =        // equals

// Literals
""              // empty string
"string"        // string
36              // positive integer

// Symbols
gibberish       // symbol
i_am_a_symbol_2 // symbol
3no             // number symbol
3true           // number true

// Keywords
mut
true false
if else or and
switch fall
func ret
for do while break continue
