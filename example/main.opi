    OPI LANGUAGE CONSTRUCT EXAMPLES

    /* Nested multiline comment */
*/


// Operators
+= ++ +     // plus
-= -- -     // minus
*= *        // star
/= /        // slash
%= %        // percent
== =        // equals

// Symbols
gibberish       // symbol
i_am_a_symbol_2 // symbol
3no             // number symbol
3true           // number true

// Keywords
true
false
